# Copiar a .env y completar. NUNCA subir .env al repositorio.

# --- Base de datos (docker-compose) ---
GSTI_OWNER_PASSWORD=cambiar-owner
GSTI_API_PASSWORD=cambiar-api
GSTI_ANALYST_PASSWORD=cambiar-analyst

# Solo para correr la API fuera de Docker:
# DATABASE_URL=postgresql+asyncpg://gsti_api:cambiar-api@localhost:5432/gsti
# MIGRATION_DATABASE_URL=postgresql+psycopg://gsti_owner:cambiar-owner@localhost:5432/gsti

ENVIRONMENT=development

# --- Secretos ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guardar copia segura: si se pierde, los datos de contacto cifrados no se recuperan.
IDENTITY_ENCRYPTION_KEY=
IDENTITY_HMAC_KEY=

# --- Protocolo de seguridad (lo define el equipo clínico) ---
BSS_ALERT_CUTOFF=1
PHQ9_ITEM9_ALERT_MIN=1
FLAG_ADVERSITY_DISCLOSURE=true

CORS_ORIGINS=["http://localhost:5173"]
